# Production Environment Variables for M9ILA
# Copy this to .env and fill in ALL values before deploying

# Database — Use a production PostgreSQL instance (e.g. Neon, Supabase, Railway)
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# NextAuth — Generate a NEW secret: openssl rand -base64 32
# NEVER reuse the development secret in production
NEXTAUTH_SECRET=""

# NextAuth — MUST be your production domain with HTTPS
# Example: https://m9ila.com
NEXTAUTH_URL=""

# OpenRouter API Key — Get from https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# SMTP — Use a production email service (SendGrid, Mailgun, Gmail App Password)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="M9ila <noreply@m9ila.com>"

# Seed Admin Password — Set a strong password for the initial admin account
# Must be at least 8 characters. Change it after first login!
SEED_ADMIN_PASSWORD=""

# Rate Limiting
RATE_LIMIT_MAX="60"
RATE_LIMIT_WINDOW="60"
